# NextBite Backend - Environment Configuration
# Copy this file to .env and fill in your values

ENVIRONMENT=development
PROJECT_ID=nextbite-demo
FIREBASE_PROJECT_ID=nextbite-demo-737c0
BIGQUERY_DATASET=nextbite
FIRESTORE_DATABASE=(default)

# Gemini API Key - get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server
HOST=0.0.0.0
PORT=8080
